{
  "name": "@dzitoe/auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NextAuth / autentikasi bersama DZITOE",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./rbac": {
      "types": "./src/rbac.ts",
      "import": "./src/rbac.ts",
      "default": "./src/rbac.ts"
    }
  },
  "files": ["src"],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@dzitoe/db": "workspace:*",
    "bcryptjs": "catalog:",
    "jose": "catalog:"
  },
  "devDependencies": {
    "@types/bcryptjs": "catalog:",
    "@types/node": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:"
  }
}
