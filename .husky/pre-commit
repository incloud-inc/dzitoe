#!/bin/sh
# ==============================================================================
# DZITOE — Git Pre-Commit Hook (Husky)
# Task: A0.11 (Setup ESLint + Prettier + Husky)
# ==============================================================================

echo "🔍 [Husky] Running pre-commit formatting & type safety checks..."

# Check code formatting with Prettier
pnpm format:check || {
  echo "❌ Prettier format check failed. Please run 'pnpm format' before committing."
  exit 1
}

# Run TypeScript typechecks across all monorepo packages
pnpm typecheck || {
  echo "❌ TypeScript typecheck failed. Please fix compilation errors before committing."
  exit 1
}

echo "✅ [Husky] Pre-commit checks passed! Proceeding with commit."
