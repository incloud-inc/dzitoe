# ==============================================================================
# DZITOE SMAN 20 Kabupaten Tangerang — Environment Template
# Task: A0.1
# ------------------------------------------------------------------------------
# Cara pakai:  copy .env.example .env.local
# File .env / .env.local TIDAK BOLEH di-commit (sudah masuk .gitignore).
# ==============================================================================

# ==============================================================================
# 1. PORT APLIKASI DZITOE (AMAN — sudah diverifikasi bebas di laptop dev)
# ==============================================================================
ADMIN_PORT=3000
MOBILE_PORT=3001
API_PORT=3002

ADMIN_HOST=127.0.0.1
MOBILE_HOST=127.0.0.1
API_HOST=127.0.0.1

ADMIN_URL=http://localhost:3000
MOBILE_URL=http://localhost:3001
API_URL=http://localhost:3002

NODE_ENV=development
APP_NAME=dzitoe
APP_ENV=local

# ==============================================================================
# 2. ⛔ RESERVED PORTS — DILARANG MUTLAK DIPAKAI DZITOE
# ==============================================================================
# Port di bawah ini SUDAH DIPAKAI project/service lain di laptop ini:
#
#   8000  -> ADZKIA      (aplikasi ujian)       ⛔ WAJIB DIHINDARI
#   5173  -> PERSOALAN   (Vite dev server)      ⛔ WAJIB DIHINDARI
#   80    -> Web server lokal (HTTP)            ⛔
#   443   -> Web server lokal (HTTPS)           ⛔
#   3306  -> MySQL lokal                        ⛔
#   6379  -> Redis lokal                        ⛔
#   5432  -> PostgreSQL lokal                   ⛔
#
# Validasi otomatis via:  pnpm ports:check
# ==============================================================================

# ==============================================================================
# 3. DATABASE — PostgreSQL
# ==============================================================================
# CATATAN PORT: 5432 TERPAKAI service lokal lain.
# DZITOE memakai port 5433 (instance/container sendiri).
DB_HOST=127.0.0.1
DB_PORT=5433
DB_PORT_FALLBACK=5432
DB_NAME=dzitoe
DB_USER=dzitoe
DB_PASSWORD=dzitoe_dev_password
DB_POOL_MAX=10
DB_SSL=false

DATABASE_URL=postgresql://dzitoe:dzitoe_dev_password@127.0.0.1:5433/dzitoe?schema=public

# ==============================================================================
# 4. CACHE / QUEUE — Redis
# ==============================================================================
# CATATAN PORT: 6379 TERPAKAI Redis lokal lain. DZITOE memakai 6380.
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_DB=0
REDIS_URL=redis://127.0.0.1:6380/0

# ==============================================================================
# 5. AUTH & SECURITY
# ==============================================================================
AUTH_SECRET=dzitoe_development_secret_key_min_32_characters_long
AUTH_TOKEN_TTL=3600
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ==============================================================================
# 6. STORAGE / UPLOAD
# ==============================================================================
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.data/uploads
MAX_UPLOAD_SIZE_MB=10
